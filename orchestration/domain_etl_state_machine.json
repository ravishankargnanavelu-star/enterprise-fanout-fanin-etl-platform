{
  "Comment": "Domain Glue ETL Execution",
  "StartAt": "RunGlueJob",
  "States": {
    "RunGlueJob": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName.$": "$.glue_job_name",
        "Arguments.$": "$.arguments"
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "FailureHandler"
        }
      ],
      "Next": "PostProcessing"
    },

    "PostProcessing": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution",
      "Parameters": {
        "StateMachineArn": "arn:aws:states:region:acct:stateMachine:PostProcessing",
        "Input.$": "$"
      },
      "End": true
    },

    "FailureHandler": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "FailureHandler",
        "Payload.$": "$"
      },
      "End": true
    }
  }
}
